{
  // Cloudflare Worker serving only static assets — no server code.
  // `npm run build` writes dist/, and Wrangler uploads it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rent-vs-buy",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}